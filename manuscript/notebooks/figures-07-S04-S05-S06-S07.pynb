   "source": [
    "import io\n",
    "import string\n",
    "import textwrap\n",
    "\n",
    "import beaker\n",
    "import cartopy.crs as ccrs\n",
    "import faceted\n",
    "import fsspec\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import wandb\n",
    "import xarray as xr\n",
    "\n",
    "import plotting\n",
    "import utils\n",
    "\n",
    "from upath import UPath"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "1e3fa778",
   "metadata": {},
   "outputs": [],
   "source": [
    "DATA_ONLY_AMIP_ROOT = UPath(\"gs://vcm-ml-experiments/spencerc/2026-04-25-amip-inference\")\n",
    "AMIP_ROOT = UPath(\"gs://vcm-ml-experiments/spencerc/2026-09-09-amip-inference\")\n",
    "DATA_ONLY_AMIP_PLUS_4K_ROOT = UPath(\"gs://vcm-ml-experiments/spencerc/2026-04-25-amip-plus-4K-data-only-inference\")\n",
    "AMIP_PLUS_4K_ROOT = UPath(\"gs://vcm-ml-experiments/spencerc/2026-09-09-amip-plus-4K-inference\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "f9571080",
   "metadata": {},
   "outputs": [],
   "source": [
    "AMIP_CASES = {\n",
    "    \"SHiELD-ic_0001\": DATA_ONLY_AMIP_ROOT,\n",
    "    \"ACE2-SHiELD\": AMIP_ROOT,\n",
    "    \"no-random-co2-energy-conserving-rs0\": AMIP_ROOT,\n",
    "    \"no-random-co2-energy-conserving-rs1\": AMIP_ROOT,\n",
    "    \"full-energy-conserving-rs0\": AMIP_ROOT,\n",
    "    \"full-energy-conserving-rs1\": AMIP_ROOT,\n",
    "}\n",
    "AMIP_PLUS_4K_CASES = {\n",
    "    \"SHiELD\": DATA_ONLY_AMIP_PLUS_4K_ROOT,\n",
    "    \"ACE2-SHiELD\": AMIP_PLUS_4K_ROOT,\n",
    "    \"no-random-co2-energy-conserving-rs0\": AMIP_PLUS_4K_ROOT,\n",
    "    \"no-random-co2-energy-conserving-rs1\": AMIP_PLUS_4K_ROOT,\n",
    "    \"full-energy-conserving-rs0\": AMIP_PLUS_4K_ROOT,\n",
    "    \"full-energy-conserving-rs1\": AMIP_PLUS_4K_ROOT,\n",
    "}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "be2725b4",
   "metadata": {},
   "outputs": [],
   "source": [
    "FILE_PATH = \"test/time_mean_diagnostics.nc\"\n",
    "\n",
    "\n",
    "def open_gcs_dataset(path: str) -> xr.Dataset:\n",
    "    with fsspec.open(str(path)) as file:\n",
    "        ds = xr.open_dataset(file, engine=\"h5netcdf\").load()\n",
    "    ds = ds.rename({v: v.replace(\"gen_map-\", \"\") for v in ds})\n",
    "    return ds\n",
    "\n",
    "\n",
    "def open_gcs_datasets(models: dict[str, UPath], sub_path: str) -> xr.Dataset:\n",
    "    datasets = {}\n",
    "    for model, root in models.items():\n",
    "        path = root / model / sub_path\n",
    "        if root == DATA_ONLY_AMIP_ROOT and model == \"SHiELD-ic_0001\":\n",
    "            label = \"SHiELD\"\n",
    "        else:\n",
    "            label = model\n",
    "        datasets[label] = open_gcs_dataset(path)\n",
    "    return xr.concat(datasets.values(), dim=\"model\").assign_coords(model=list(datasets.keys()))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "f38dbefb",
   "metadata": {},
   "outputs": [],
   "source": [
    "mean_control_ds = open_gcs_datasets(AMIP_CASES, FILE_PATH)\n",
    "plus_4k_ds = open_gcs_datasets(AMIP_PLUS_4K_CASES, FILE_PATH)\n",
    "response = plus_4k_ds - mean_control_ds"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "04da9bc7",
   "metadata": {},
   "outputs": [],
   "source": [
    "aspect_ratio = plotting.get_aspect_ratio(ccrs.Robinson(), (-180, 180, -89.84, 89.84))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "036e26d3",
   "metadata": {},
   "outputs": [],
   "source": [
    "MAIN_MODELS = [\"SHiELD\", \"ACE2-SHiELD\", \"no-random-co2-energy-conserving-rs0\", \"full-energy-conserving-rs0\"]\n",
    "ALTERNATE_MODELS = {\n",
    "    \"no-random-co2-energy-conserving-rs0\": \"no-random-co2-energy-conserving-rs1\",\n",
    "    \"full-energy-conserving-rs0\": \"full-energy-conserving-rs1\"\n",
    "}\n",
    "LABELS = {\n",
    "    \"SHiELD\": \"SHiELD\",\n",
    "    \"ACE2-SHiELD\": \"ACE2-SHiELD\",\n",
    "    \"no-random-co2-energy-conserving-rs0\": \"ACE2S-SHiELD+$_{\\\\text{no-RC}}$\",\n",
    "    \"no-random-co2-energy-conserving-rs1\": \"ACE2S-SHiELD+$_{\\\\text{no-RC}}$\",\n",
    "    \"full-energy-conserving-rs0\": \"ACE2S-SHiELD+\",\n",
    "    \"full-energy-conserving-rs1\": \"ACE2S-SHiELD+\",\n",
    "}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "d67ae5d0",
   "metadata": {},
   "outputs": [],
   "source": [
    "plotting.configure_style()\n",
    "\n",
    "def plot_response(response, models, alternate_models, variable, long_name, units, filename, scale_factor=1.0, vmin=-15, vmax=15, bottom_pad=0.85):\n",
    "    fig, axes, (cax1, cax2) = faceted.faceted(\n",
    "        4, \n",
    "        2, \n",
    "        aspect=aspect_ratio, \n",
    "        width=5.5,\n",
    "        cbar_pad=0.125,\n",
    "        internal_pad=0.25,\n",
    "        cbar_mode=\"edge\", \n",
    "        cbar_location=\"bottom\", \n",
    "        axes_kwargs={\"projection\": ccrs.Robinson()},\n",
    "        left_pad=0.35,\n",
    "        bottom_pad=bottom_pad,\n",
    "    )\n",
    "\n",
    "    cmap = \"RdBu_r\"\n",
    "    response = scale_factor * response[variable]\n",
    "    response_bias = response.drop_sel(model=\"SHiELD\") - response.sel(model=\"SHiELD\")\n",
    "\n",
    "    weights = np.cos(np.deg2rad(response.lat))\n",
    "    mean = response.weighted(weights).mean([\"lat\", \"lon\"]).compute()\n",
    "    rmse = np.sqrt((response_bias ** 2).weighted(weights).mean([\"lat\", \"lon\"])).compute()\n",
    "\n",
    "    for ax, model in zip(axes[::2], models):\n",
    "        p1 = response.sel(model=model).plot(\n",
    "            ax=ax,\n",
    "            add_colorbar=False,\n",
    "            vmin=vmin,\n",
    "            vmax=vmax,\n",
    "            cmap=cmap,\n",
    "            transform=ccrs.PlateCarree(),\n",
    "        )\n",
    "        ax.coastlines()\n",
    "\n",
    "        alternate_model = alternate_models.get(model)\n",
    "        global_mean = mean.sel(model=model).item()\n",
    "        if alternate_model is None:\n",
    "            ax.set_title(f\"Global mean = {global_mean:0.2f} {units}\")\n",
    "        else:\n",
    "            alternate_global_mean = mean.sel(model=alternate_model).item()\n",
    "            ax.set_title(f\"Global mean = {global_mean:0.2f} ({alternate_global_mean:0.2f}) {units}\")\n",
    "\n",
    "        ax.annotate(\n",
    "            LABELS[model],\n",
    "            xy=(0, 0.5),\n",
    "            xytext=(-17, 0),\n",
    "            xycoords=\"axes fraction\",\n",
    "            textcoords=\"offset points\",\n",
    "            ha=\"center\",\n",
    "            va=\"center\",\n",
    "            rotation=90,\n",
    "        )\n",
    "\n",
    "    for ax, model in zip(axes[3::2], models[1:]):\n",
    "        p2 = response_bias.sel(model=model).plot(\n",
    "            ax=ax,\n",
    "            add_colorbar=False,\n",
    "            vmin=vmin,\n",
    "            vmax=vmax,\n",
    "            cmap=cmap,\n",
    "            transform=ccrs.PlateCarree(),\n",
    "        )\n",
    "        ax.coastlines()\n",
    "\n",
    "        alternate_model = alternate_models.get(model)\n",
    "        global_rmse = rmse.sel(model=model).item()\n",
    "        if alternate_model is None:\n",
    "            ax.set_title(f\"Global RMSB = {global_rmse:0.2f} {units}\")\n",
    "        else:\n",
    "            alternate_global_rmse = rmse.sel(model=alternate_model).item()\n",
    "            ax.set_title(f\"Global RMSB = {global_rmse:0.2f} ({alternate_global_rmse:0.2f}) {units}\")\n",
    "\n",
    "    for ax, label in zip(axes[::2] + axes[3::2], string.ascii_lowercase):\n",
    "        ax.annotate(\n",
    "            f\"({label})\",\n",
    "            xy=(0, 1),\n",
    "            xytext=(2, -2),\n",
    "            va=\"top\",\n",
    "            xycoords=\"axes fraction\",\n",
    "            textcoords=\"offset points\",\n",
    "        )\n",
    "\n",
    "    axes[1].set_visible(False)\n",
    "    label = textwrap.fill(f\"2012-2020 mean {long_name} response to a uniform +4 K SST perturbation [{units}]\", 40)\n",
    "    fig.colorbar(p1, cax=cax1, orientation=\"horizontal\", label=label)\n",
    "    fig.colorbar(p2, cax=cax2, orientation=\"horizontal\", label=f\"Bias (ACE minus SHiELD) [{units}]\")\n",
    "    fig.patch.set_alpha(0.0)\n",
    "    fig.savefig(f\"{filename}.png\", dpi=300)\n",
    "    fig.savefig(f\"{filename}.pdf\")"
   ]
  },
