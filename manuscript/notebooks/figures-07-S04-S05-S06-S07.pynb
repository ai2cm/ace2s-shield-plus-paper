   "source": [
    "_, pressure_interpolated_control = pressure_interpolate(mean_control_ds)\n",
    "weights, pressure_interpolated_plus_4k = pressure_interpolate(plus_4k_ds)\n",
    "pressure_interpolated_response = pressure_interpolated_plus_4k - pressure_interpolated_control\n",
    "pressure_interpolated_response_bias = pressure_interpolated_response.drop_sel(model=\"SHiELD\") - pressure_interpolated_response.sel(model=\"SHiELD\")"
   ]
