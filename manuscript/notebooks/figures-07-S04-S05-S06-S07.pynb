    "plot_response(response, MAIN_MODELS, ALTERNATE_MODELS, \"USWRFtoa\", \"upward shortwave radiative flux at the top of the atmosphere\", \"W/m$^2$\", \"figure-S05\", vmin=-20, vmax=20)"
   ]
